{
  "name": "WF-B-T5 | Tool: query_metabase_sql",
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "sql"
            }
          ]
        }
      },
      "id": "wfbt5-0001-0001-0001-000000000001",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst sql = raw?.sql || raw?.query || raw?.body?.sql || raw?.body?.query;\nif (!sql || !String(sql).trim()) {\n  // DEBUG: mostrar todo lo que llega para diagnosticar\n  throw new Error('sql vacío. RAW INPUT: ' + JSON.stringify(raw) + ' | KEYS: ' + Object.keys(raw || {}).join(','));\n}\nconst sqlStr = String(sql).trim();\nconst norm = sqlStr.toUpperCase();\nif (!norm.startsWith('SELECT') && !norm.startsWith('WITH')) {\n  throw new Error('Solo SELECT o WITH. Recibido: ' + norm.split(/\\\\s+/)[0]);\n}\nreturn [{ json: { sql: sqlStr } }];"
      },
      "id": "wfbt5-0002-0002-0002-000000000002",
      "name": "Validar SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        510,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://bia.metabaseapp.com/api/dataset",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "PEGA_AQUI_TU_METABASE_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ database: 2344, type: 'native', native: { query: $json.sql } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "wfbt5-0003-0003-0003-000000000003",
      "name": "Ejecutar SQL Gold Layer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        770,
        500
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nif (resp.error) return [{ json: { result: 'ERROR', error: resp.error, rows: [], count: 0 } }];\nconst cols = (resp.data?.cols || []).map(c => c.name);\nconst rows_raw = resp.data?.rows || [];\nconst rows = rows_raw.map(r => Object.fromEntries(cols.map((c, i) => [c, r[i]])));\nreturn [{ json: { result: 'OK', rows, count: rows.length } }];"
      },
      "id": "wfbt5-0004-0004-0004-000000000004",
      "name": "Formatear resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1030,
        500
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Validar SQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar SQL": {
      "main": [
        [
          {
            "node": "Ejecutar SQL Gold Layer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ejecutar SQL Gold Layer": {
      "main": [
        [
          {
            "node": "Formatear resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": {
    "instanceId": ""
  }
}