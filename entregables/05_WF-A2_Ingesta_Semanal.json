            { "name": "x-api-key", "value": "={{ $vars.METABASE_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"database\":2311,\"type\":\"native\",\"native\":{\"query\":\"SELECT t.contractor_id::text AS id, t.contractor_name, t.cost_type, t.year AS tariff_year, t.name AS tariff_name, t.valid_from, t.valid_to, true AS is_active, t.id AS source_tariff_id, t.created_at, t.updated_at FROM tariff t ORDER BY t.id\"}}",
        "options": {}
      },
      "id": "wfa2-0002-0002-0002-000000000002",
      "name": "MB → contractors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [510, 500],
      "notes": "DB 2311 — prod-electrician-services-contractor. 13 filas. FK padre de tariff_catalog."
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst cols = r.data.cols.map(c => c.name);\nconst rows = r.data.rows;\nconst ingested_at = new Date().toISOString();\nreturn rows.map(row => ({\n  json: { ...Object.fromEntries(cols.map((c, i) => [c, row[i]])), ingested_at }\n}));"
      },
      "id": "wfa2-0003-0003-0003-000000000003",
